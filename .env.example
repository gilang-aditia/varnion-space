# Salin menjadi .env.local lalu sesuaikan.

# mock (default) = data contoh di browser · http = backend REST sungguhan
VITE_API_MODE=mock

# Dipakai bila VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:8000/api

# Latensi buatan mock server (ms) untuk mensimulasikan jaringan
VITE_MOCK_LATENCY_MS=200
